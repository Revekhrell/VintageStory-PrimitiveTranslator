<Window x:Class="PrimitiveTranslator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PrimitiveTranslator.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:dmodels="clr-namespace:PrimitiveTranslator.Data.Models"
        xmlns:editors="clr-namespace:PrimitiveTranslator.Editors"
        xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
        mc:Ignorable="d"
        Title="{Binding Strings.MainWindowTitle}" d:Title="Примитивный переводчик" Width="800" Height="450" Background="#1E1E1E"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="200" Width="{Binding LeftPanelWidth, Mode=TwoWay}"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!--Разделитель-->
        <GridSplitter Grid.Column="1" Width="3" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{StaticResource BorderBrushDefault}"/>
        
        <!--Левая панель-->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <!--Параметры-->
            <GroupBox Grid.Row="0" d:Header="Настройки" Header="{Binding Strings.SettingsHeader}" Margin="2"
                      Style="{StaticResource GroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!--Язык-->
                    <TextBlock Grid.Row="0" Grid.Column="0" d:Text="Язык" Margin="3,2" Style="{StaticResource TextBlockStyle}"
                               Text="{Binding Strings.LanguageLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="3,2" d:Text="ru"
                             HorizontalContentAlignment="Center" Style="{StaticResource TextBoxStyle}"
                             Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <!--Разделитель-->
                    <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="1" Margin="3,2,3,-2"
                               Fill="{StaticResource BorderBrushDefault}"/>

                    <!--Папка модов-->
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" d:Text="Папка модов:" Margin="3,4,3,0"
                               Text="{Binding Strings.ModsDirectoryLabel}" Style="{StaticResource TextBlockStyle}"/>
                    <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="3,2" IsReadOnly="True" d:Text="C:\Sample"
                             Style="{StaticResource TextBoxStyle}" Text="{Binding ModsDirectory}"/>
                    <Button Grid.Row="3" Grid.Column="2" Margin="0,2,3,2"
                            ToolTip="{Binding Strings.SelectDirectoryTooltip}" ToolTipService.InitialShowDelay="2000"
                            Command="{Binding OpenModsDirectoryCommand}"
                            Style="{StaticResource VerticalSquareButtonStyle}">
                        <Image Source="{StaticResource OpenDirectoryDrawingImage}"/>
                    </Button>
                    <ProgressBar Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Height="5" Margin="3,2" d:Value="30"
                                 Value="{Binding ModsProgressBarValue}" Maximum="{Binding ModsProgressBarMaximum}"
                                 Visibility="{Binding ModsProgressBarVisibility}"/>

                    <!--Разделитель-->
                    <Rectangle Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Height="1" Margin="3,2,3,-2"
                               Fill="{StaticResource BorderBrushDefault}"/>

                    <!--Папка экспорта-->
                    <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" d:Text="Папка экспорта:" Margin="3,4,3,0"
                               Text="{Binding Strings.ExportDirectoryLabel}" Style="{StaticResource TextBlockStyle}"/>
                    <TextBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="3,2" IsReadOnly="True" d:Text="C:\Sample2"
                             Text="{Binding ExportDirectory}" Style="{StaticResource TextBoxStyle}"/>
                    <Button Grid.Row="7" Grid.Column="2" Margin="0,2,3,2" BorderThickness="0"
                            ToolTip="{Binding Strings.SelectDirectoryTooltip}" ToolTipService.InitialShowDelay="2000"
                            Command="{Binding OpenExportDirectoryCommand}"
                            Style="{StaticResource VerticalSquareButtonStyle}">
                        <Image Source="{StaticResource OpenDirectoryDrawingImage}"/>
                    </Button>
                    <ProgressBar Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Height="5" Margin="3,2" d:Value="30"
                                 Value="{Binding ExportProgressBarValue}" Maximum="{Binding ExportProgressBarMaximum}"
                                 Visibility="{Binding ExportProgressBarVisibility}"/>

                    <!--Разделитель-->
                    <Rectangle Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Height="1" Margin="3,2,3,-2"
                               Fill="{StaticResource BorderBrushDefault}"/>

                    <!--Папка модов-->
                    <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" d:Text="Языки экспорта:" Margin="3,4,3,0"
                               Text="{Binding Strings.ExportLanguagesLabel}" Style="{StaticResource TextBlockStyle}"/>
                    <TextBox Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" Margin="3,2" d:Text="ru,is,fr"
                             Style="{StaticResource TextBoxStyle}" Text="{Binding Languages, UpdateSourceTrigger=PropertyChanged}"/>

                    <!--Информация о моде-->
                    <Button Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3" Margin="3,3,3,0" Content="modinfo.json"
                            Command="{Binding EditModInfoCommand}" Style="{StaticResource ButtonStyle}"/>
                </Grid>
            </GroupBox>
            
            <!--Панель кнопок-->
            <Border Grid.Row="1" Height="25" Margin="3,2,3,3" CornerRadius="3"
                    BorderBrush="{StaticResource BorderBrushDefault}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <!--Перезагрузить моды-->
                    <Button BorderThickness="1,0,1,0" Margin="-0.5,0" Command="{Binding ReloadModsCommand}"
                            ToolTip="{Binding Strings.ReloadModsTooltip}" ToolTipService.InitialShowDelay="2000"
                            Style="{StaticResource VerticalSquareButtonStyle}">
                        <Image Source="{StaticResource ReloadDrawingImage}"/>
                    </Button>
                    
                    <!--Экспорт переводчика-->
                    <Button BorderThickness="1,0,1,0" Margin="10,0" Command="{Binding ExportCommand}"
                            ToolTip="{Binding Strings.ExportTooltip}" ToolTipService.InitialShowDelay="2000"
                            Style="{StaticResource VerticalSquareButtonStyle}">
                        <Image Source="{StaticResource ArchivateDrawingImage}"/>
                    </Button>
                    
                    <!--Автоматический перевод-->
                    <Button BorderThickness="1,0,1,0" Margin="0,0,10,0" Command="{Binding TranslateCommand}"
                            ToolTip="{Binding Strings.TranslateTooltip}" ToolTipService.InitialShowDelay="2000"
                            Style="{StaticResource VerticalSquareButtonStyle}">
                        <Image Source="{StaticResource TranslateDrawingImage}"/>
                    </Button>

                    <!--Автоматический перевод-->
                    <Button BorderThickness="1,0,1,0" Margin="0,0,10,0" Command="{Binding DeleteCommand}"
                            ToolTip="{Binding Strings.DeleteTooltip}" ToolTipService.InitialShowDelay="2000"
                            Style="{StaticResource VerticalSquareButtonStyle}">
                        <Image Source="{StaticResource DeleteDrawingImage}"/>
                    </Button>
                </StackPanel>
            </Border>
            
            <!--Список модов-->
            <Border Grid.Row="2" Margin="3,0,3,3" BorderThickness="1" BorderBrush="{StaticResource BorderBrushDefault}"
                    CornerRadius="3">
                <ListBox x:Name="ModsListBox" ItemsSource="{Binding ModsView}" SelectedIndex="{Binding SelectedModIndex}"
                         BorderThickness="0" SelectionMode="Extended" Style="{DynamicResource ListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dmodels:Mod}">
                            <Grid ToolTip="{Binding Description}" ToolTipService.InitialShowDelay="2000">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <!--Языки-->
                                <ComboBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" FontSize="13" Margin="0,0,3,0"
                                          Padding="7,0,-1,0" SelectedItem="{Binding Language}" ItemsSource="{Binding LanguagesView}"
                                          Style="{StaticResource ComboBoxStyle}"/>

                                <!--Название и идентификатор-->
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Text="{Binding}"
                                           Style="{StaticResource TextBlockStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="10" Text="{Binding UID}"
                                           Foreground="{StaticResource BorderBrushDefault}"
                                           Style="{StaticResource TextBlockStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <EventSetter Event="PreviewMouseDown" Handler="ModsListItem_PreviewMouseDown"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Grid>
        
        <!--Редактор-->
        <dragablz:TabablzControl x:Name="TabControl" Grid.Column="2" Style="{DynamicResource TabablzControlStyle}"
                                 ItemsSource="{Binding TabsView}" SelectedItem="{Binding SelectedTab}">
            <dragablz:TabablzControl.HeaderItemTemplate>
                <DataTemplate DataType="{x:Type editors:JsonEditor}">
                    <Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            
                            <!--Заголовок-->
                            <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TextBlockStyle}"/>
                            
                            <!--Маркер редактирования-->
                            <TextBlock Grid.Column="2" Text="*" Style="{StaticResource TextBlockStyle}"
                                       Visibility="{Binding IsModified, Mode=OneWay, Converter={StaticResource BoolToVisibilityCollapsedConverter}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </dragablz:TabablzControl.HeaderItemTemplate>
            <dragablz:TabablzControl.ContentTemplate>
                <DataTemplate DataType="{x:Type editors:JsonEditor}">
                    <Frame Content="{Binding ., Converter={StaticResource JsonEditorToTextEditorConverter}}"/>
                </DataTemplate>
            </dragablz:TabablzControl.ContentTemplate>
        </dragablz:TabablzControl>
    </Grid>
</Window>